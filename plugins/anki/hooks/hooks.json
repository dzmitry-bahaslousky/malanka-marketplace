{
  "description": "Suggests Anki card questions when a conversation surfaces something worth remembering",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_PLUGIN_OPTION_SUGGEST_CARDS\" = false ] || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/suggest-cards.md\""
          }
        ]
      }
    ]
  }
}
